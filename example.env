# The public route to the host
PUBLIC_HOST="mydomain.com" 
# The password (not full pass string - e.g. admin:PREFECT_PASSWORD) for accessing prefect
PREFECT_PASSWORD="test_password"
# The url to access the database
PREFECT_API_DATABASE_CONNECTION_HOST="postgres:5432"

# Prefect API URL and auth are derived from PUBLIC_HOST and PREFECT_PASSWORD
# when the flow starts. Override them here if needed.
# PREFECT_API_URL="https://mydomain.com/api"
# PREFECT_API_AUTH_STRING="admin:test_password"
